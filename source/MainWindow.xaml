<Window x:Class="DreamMcuToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="梦想成为单片机大手"
        Width="1420" Height="870" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.82,0.08" GradientOrigin="0.82,0.08" RadiusX="0.7" RadiusY="0.7">
                <GradientStop Color="#132520" Offset="0"/>
                <GradientStop Color="#0A1119" Offset="0.7"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#182732" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#54E8D2" Offset="0"/>
                                <GradientStop Color="#1AA995" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="24" Foreground="#072B27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Width="7" Height="7" Background="#F8FAFC" CornerRadius="3.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="梦想成为" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="单片机大手" FontSize="19" FontWeight="Bold" Foreground="#F3F9FB" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="工具中心" FontSize="11" FontWeight="SemiBold" Foreground="#506577" Margin="12,0,0,7"/>
                    <ListBox x:Name="CategoryList" AutomationProperties.Name="工具分类" AutomationProperties.AutomationId="CategoryList"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Categories}"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="27"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#172631" CornerRadius="8" Padding="7,2" MinWidth="24">
                                        <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#73899A"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Border Height="1" Background="#1C2B36" Margin="6,0,6,13"/>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="OpenReadme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"/>
                            <TextBlock Text="使用说明" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Click="OpenToolsFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0"/>
                            <TextBlock Text="打开工具目录" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="8,11,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="#2DD4BF" VerticalAlignment="Top" Margin="0,5,0,0"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="本地目录封装版  v1.0" FontSize="10" Foreground="#607587"/>
                            <TextBlock Text="不内置第三方安装包" FontSize="10" Foreground="#43596A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Column="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="点亮第一颗 LED" FontSize="26" FontWeight="Bold" Foreground="#F4F9FB"/>
                        <Border Background="#14322E" CornerRadius="7" Padding="8,3" Margin="11,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MCU WORKBENCH" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                                       FontWeight="SemiBold" Foreground="#5DE0CC"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="烧录、连接、调试与日常开发工具，一个入口找到。" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" AutomationProperties.Name="重新扫描" Content="&#xE72C;" Click="Rescan_Click"
                            ToolTip="重新扫描本机已安装软件"/>
                    <Button Style="{StaticResource SoftButton}" AutomationProperties.Name="添加本地程序" Margin="9,0,0,0" Click="AddLocal_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"/>
                            <TextBlock Text="添加本地程序" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0F1A24" BorderBrush="#253843" BorderThickness="1" CornerRadius="11" Height="43">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#698090" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索工具" AutomationProperties.AutomationId="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#E3EDF2" CaretBrush="#2DD4BF" FontSize="13"
                                     VerticalContentAlignment="Center" Padding="0,0,14,1"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="搜索工具、厂商或标签…" FontSize="12" Foreground="#5D7283"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                <CheckBox x:Name="OnlyLocalCheck" Grid.Column="2" Content="仅显示本地可用" AutomationProperties.Name="仅显示本地可用" AutomationProperties.AutomationId="OnlyLocalCheck"
                          Style="{StaticResource ToggleCheckBox}" Margin="18,0,4,0"
                          Checked="FilterOptionChanged" Unchecked="FilterOptionChanged"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" MinWidth="500"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- 工具列表 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,3,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCategoryName}" FontSize="15" FontWeight="Bold"/>
                            <Border Background="#162630" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ResultCount}" FontSize="10" Foreground="#7E94A4"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ScanStatusText}" FontSize="10" Foreground="#607587"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ToolList" AutomationProperties.Name="工具列表" AutomationProperties.AutomationId="ToolList" ItemsSource="{Binding FilteredTools}"
                                 SelectionChanged="ToolList_SelectionChanged"
                                 MouseDoubleClick="ToolList_MouseDoubleClick"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource CardItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="50" Height="50" CornerRadius="12" Background="{Binding CategoryBrush}"
                                                BorderBrush="#263C49" BorderThickness="1" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="22" Foreground="{Binding AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconImage}" Width="30" Height="30" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="10,0,12,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#F0F7FA"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#64798A" Margin="9,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" Foreground="#879CAC"
                                                       TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding TagsText}" FontSize="9.5" Foreground="#5E7383"
                                                       TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                        </Grid>
                                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Style="{StaticResource GhostButton}" Width="29" Height="29"
                                                    Padding="0" HorizontalAlignment="Right"
                                                    Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                    Tag="{Binding}" Click="FavoriteCard_Click" AutomationProperties.Name="收藏或取消收藏" ToolTip="收藏/取消收藏"/>
                                            <Border Grid.Row="1" Background="#13212B" CornerRadius="7" Padding="9,3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9.5" Foreground="#91A8B7"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Padding="12,5"
                                                    FontSize="10.5" Content="{Binding ActionLabel}"
                                                    Tag="{Binding}" Click="LaunchCard_Click"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="EmptyStateBorder" Background="#0E1821" BorderBrush="#20313D" BorderThickness="1"
                                CornerRadius="13" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="58" Height="58" CornerRadius="16" Background="#14242E">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="23" Foreground="#5A7181" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="没有找到匹配工具" FontSize="14" FontWeight="SemiBold" Foreground="#B9C9D2"
                                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="换个关键词，或关闭“仅本地可用”筛选。" FontSize="11" Foreground="#5F7484"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 右侧详情 -->
                <Border Grid.Column="2" Background="#0F1922" BorderBrush="#20323F" BorderThickness="1" CornerRadius="15">
                    <Grid>
                        <ContentControl Content="{Binding SelectedTool}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="22,21,20,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="60" Height="60" CornerRadius="15" Background="{Binding CategoryBrush}"
                                                        BorderBrush="#29404E" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="26" Foreground="{Binding AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding IconImage}" Width="36" Height="36" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border Background="#17242D" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#88A0B1"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="#6D8292" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                        Padding="0" Content="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}"
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                        Tag="{Binding}" Click="FavoriteCard_Click" AutomationProperties.Name="收藏或取消收藏" ToolTip="收藏/取消收藏"/>
                                            </Grid>

                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#F3F9FB"
                                                       Margin="0,17,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#9CB0BE"
                                                       TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20"/>

                                            <Border Height="1" Background="#1C2C38" Margin="0,18,0,16"/>

                                            <TextBlock Text="工具简介" FontSize="11" FontWeight="SemiBold" Foreground="#667E8E"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#B4C5D0"
                                                       TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>

                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,16,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#152530" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding}" FontSize="9.5" Foreground="#86A0B0"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="#101F28" BorderBrush="#203541" BorderThickness="1"
                                                    CornerRadius="9" Padding="12,10" Margin="0,14,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="#6F8798"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="许可证与使用边界" FontSize="9.5" Foreground="#617989"/>
                                                        <TextBlock Text="{Binding License}" FontSize="10.5" Foreground="#A4B7C3"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#0D1A22" BorderBrush="#1E3540" BorderThickness="1"
                                                    CornerRadius="9" Padding="12,10" Margin="0,9,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBrush}" Margin="7,0,0,0"/>
                                                        <TextBlock Text="  ·  " FontSize="10" Foreground="#425968"/>
                                                        <TextBlock Text="{Binding StatusDetail}" FontSize="9.5" Foreground="#718797"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LocalPath}" FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="9" Foreground="#546B7B" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding LocalPath}" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}"
                                                    Tag="{Binding}" Click="Launch_Click" HorizontalContentAlignment="Center"
                                                    Margin="0,18,0,0"/>
                                            <Grid Margin="0,9,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource SoftButton}" Grid.Column="0" Click="OpenHomepage_Click"
                                                        Content="打开官网"/>
                                                <Button Style="{StaticResource SoftButton}" Grid.Column="2" Click="OpenToolFolder_Click"
                                                        Content="所在目录"/>
                                            </Grid>
                                            <TextBlock Text="提示：商业软件、驱动与厂商工具请从其官方渠道获取并遵守许可。"
                                                       FontSize="9" Foreground="#536A7A" TextWrapping="Wrap"
                                                       Margin="0,14,0,0" LineHeight="16"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <Border x:Name="DetailPlaceholderBorder" Background="#0F1922" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="68" Height="68" CornerRadius="20" Background="#142630">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="28" Foreground="#355467" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="选择一个工具" FontSize="14" FontWeight="SemiBold" Foreground="#A7BAC6"
                                           Margin="0,14,0,0"/>
                                <TextBlock Text="查看详情、官网与本地状态" FontSize="10.5" Foreground="#5A7080"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
